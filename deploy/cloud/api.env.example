# Copy values into a SEPARATE cloud environment group, never overwrite apps/api/.env.
NODE_ENV=production
WEB_ORIGIN=https://crm-staging.example.com
# Transaction pool is optional; start with the direct URL if no pool has been reviewed.
DATABASE_URL=postgresql://crm:replace-me@database.example.com:25060/crm_staging
DATABASE_DIRECT_URL=postgresql://crm:replace-me@database.example.com:25060/crm_staging
DATABASE_SSL_MODE=verify-full
# PEM certificate from the database provider; literal \n is supported by runtime configuration.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=3
DATABASE_LOCK_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_MS=5000
REDIS_URL=rediss://replace-with-render-internal-url
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_COOKIE_SAME_SITE=lax
# Determine the actual trusted proxy addresses first. Empty is safe but may share the IP budget.
AUTH_TRUSTED_PROXY_CIDRS=
WEBHOOK_QUEUE_ENABLED=true
ZALO_QUEUE_ENABLED=true
META_QUEUE_ENABLED=true
REMINDER_QUEUE_ENABLED=true
DISABLE_AUTOMATION_WORKER=false
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Optional queue retention. Removing failed jobs also removes their queue history; preserve durable business/audit records.
QUEUE_FAILED_RETENTION_COUNT=1000
OPERATIONS_ENVIRONMENT=crm-staging
OPERATIONS_POLL_MS=15000
OPERATIONS_HEARTBEAT_MS=15000
OPERATIONS_STALE_MS=90000
OPERATIONS_ALERT_WEBHOOK_URL=
# Keep legacy URL attachments until an authorized upload/download flow has been integrated.
FILE_STORAGE_PROVIDER=external
S3_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=crm-staging-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_SECONDS=300
# Cloud release orchestration is not enabled by this preparation template.
RELEASE_CONTROL_URL=
RELEASE_CONTROL_TOKEN=
# Copy integration credentials/encryption keys from apps/api/.env.example as needed.
# They must match between all services in this environment, and differ from production.
