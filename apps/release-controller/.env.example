# Dedicated database, initialized with npm run db:init --workspace apps/release-controller
CONTROL_DATABASE_URL=postgresql://release_operator:replace-me@localhost:5432/crm_release_control
CONTROL_API_TOKEN=replace-with-a-unique-random-token-of-at-least-32-characters
CONTROL_CI_TOKEN=replace-with-a-different-random-token-of-at-least-32-characters
CONTROL_RECOVERY_TOKEN=replace-with-a-third-random-token-of-at-least-32-characters
CONTROL_BIND_HOST=127.0.0.1
CONTROL_PORT=3100
CONTROL_IMAGE_PREFIX=ghcr.io/hnauuh-fedx/crm-fedx/
# Set only after a DBA verifies the actual CRM schema is compatible in both environments.
CONTROL_SCHEMA_GENERATION=crm-2026-10-28
CONTROL_STAGING_DIRECTORY=/srv/admission-crm/staging
CONTROL_PRODUCTION_DIRECTORY=/srv/admission-crm/production
