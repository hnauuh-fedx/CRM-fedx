PORT=3000
DATABASE_URL=
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=28800
METABASE_PUBLIC_URL=http://localhost:3001
METABASE_EMBEDDING_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
METABASE_DASHBOARD_SALE_PIPELINE_ID=
METABASE_GUEST_TOKEN_TTL_SECONDS=300
REDIS_URL=redis://localhost:6379

# Zalo OA integration. Dynamic access/refresh tokens are encrypted in PostgreSQL.
ZALO_APP_ID=
ZALO_APP_SECRET=              # Khóa bị mật của app zalo OA
ZALO_OA_SECRET_KEY=           # Khi đã thêm webhook URL thành công sẽ nhận được OA secret key
ZALO_TOKEN_ENCRYPTION_KEY=    # Khóa để mã hóa token truy cập và token làm mới

# GPT_API_KEY is preferred. GPT-API-KEY is accepted temporarily for compatibility.
GPT_API_KEY=
GPT_MODEL=gpt-5.4-mini
