PORT=3000
# Dịch vụ triển khai độc lập; token chỉ nằm trên server, không đưa vào VITE_*.
RELEASE_CONTROL_URL=
RELEASE_CONTROL_TOKEN=
DATABASE_URL=postgresql://postgres:251224@localhost:5432/crm_db
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=900
AUTH_COOKIE_SAME_SITE=lax
# Empty for direct access. Set only actual reverse-proxy IPs/CIDRs, never wildcard/hop count.
AUTH_TRUSTED_PROXY_CIDRS=
# All login attempts count, including successful/malformed requests; shared PostgreSQL state.
AUTH_LOGIN_IP_LIMIT=100
AUTH_LOGIN_IP_WINDOW_SECONDS=300
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_ACCOUNT_WINDOW_SECONDS=900
REDIS_URL=redis://localhost:6379

# Readiness requires Redis while any queue feature is enabled.
WEBHOOK_QUEUE_ENABLED=true
DISABLE_AUTOMATION_WORKER=false
ZALO_QUEUE_ENABLED=true
META_QUEUE_ENABLED=true
REMINDER_QUEUE_ENABLED=true
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Set true only after confirming the provider deduplicates by Idempotency-Key.
AUTOMATION_EMAIL_IDEMPOTENCY_SUPPORTED=false
AUTOMATION_SMS_IDEMPOTENCY_SUPPORTED=false
AUTOMATION_ZNS_IDEMPOTENCY_SUPPORTED=false
AUTOMATION_WEBHOOK_IDEMPOTENCY_SUPPORTED=false

# Run independently: npm run monitor:operations --workspace apps/api
OPERATIONS_ENVIRONMENT=local
OPERATIONS_POLL_MS=15000
OPERATIONS_HEARTBEAT_MS=15000
OPERATIONS_STALE_MS=90000
OPERATIONS_ALERT_AFTER_MS=60000
OPERATIONS_RECOVERY_AFTER_MS=30000
# Default delivery is structured stdout. Optional HTTPS receiver, monitor only.
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_TOKEN=
# Per actual queue name; durations in milliseconds, waitingCount/failedCount are counts.
OPERATIONS_QUEUE_THRESHOLDS={}

# Run API and automation queue workers as separate processes in production.
AUTOMATION_PROCESS_ROLE=api
AUTOMATION_SECRET_ENCRYPTION_KEY= # Khóa tối thiểu 32 ký tự để mã hóa webhook secret
AUTOMATION_EMAIL_PROVIDER_URL=
AUTOMATION_EMAIL_PROVIDER_TOKEN=
AUTOMATION_SMS_PROVIDER_URL=
AUTOMATION_SMS_PROVIDER_TOKEN=
AUTOMATION_ZNS_PROVIDER_URL=
AUTOMATION_ZNS_PROVIDER_TOKEN=

# Zalo OA integration. Dynamic access/refresh tokens are encrypted in PostgreSQL.
ZALO_APP_ID=
ZALO_APP_SECRET=              # Khóa bị mật của app zalo OA
ZALO_OA_SECRET_KEY=           # Khi đã thêm webhook URL thành công sẽ nhận được OA secret key
ZALO_TOKEN_ENCRYPTION_KEY=    # Khóa để mã hóa token truy cập và token làm mới

# Meta business
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_TOKEN_ENCRYPTION_KEY=
META_OAUTH_REDIRECT_URI=       # VD: https://your-ngrok-domain.ngrok-free.dev/api/integrations/meta/oauth/callback
META_GRAPH_API_VERSION=v26.0

TIKTOK_APP_ID=
TIKTOK_SECRET=
TIKTOK_API_BASE=https://sandbox-ads.tiktok.com/open_api/v1.3   # Production: https://business-api.tiktok.com/open_api/v1.3
TIKTOK_ACCESS_TOKEN=          # Sandbox: bấm Generate trong mục Sandbox Ad Account
TIKTOK_ADVERTISER_ID=

# GPT_API_KEY is preferred. GPT-API-KEY is accepted temporarily for compatibility.
GPT_API_KEY=
GPT_MODEL=gpt-5.4-mini
