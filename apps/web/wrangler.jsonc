{
  // Cloudflare Workers Static Assets: serve the Vite build; the Worker script
  // only runs for /api/* and forwards it to the API on the same origin.
  "name": "crm-fedx",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://admission-crm-staging-api.onrender.com"
  }
  // EDGE_PROXY_SECRET is a secret: `wrangler secret put EDGE_PROXY_SECRET`.
}
