  leads_leads_assigned_toTousers                       leads[]                 @relation("leads_assigned_toTousers")
  leads_leads_owner_idTousers                          leads[]                 @relation("leads_owner_idTousers")
  marketing_forms                                      marketing_forms[]
  notifications                                        notifications[]
  reminders                                            reminders[]
  student_services                                     student_services[]
  user_access_scopes                                   user_access_scopes?
  user_departments                                     user_departments[]
  user_roles                                           user_roles[]
  custom_fields_created_by                             custom_fields[] @relation("custom_fields_created_by")
  custom_fields_updated_by                             custom_fields[] @relation("custom_fields_updated_by")
  custom_field_groups_created_by                       custom_field_groups[] @relation("custom_field_groups_created_by")
  custom_field_groups_updated_by                       custom_field_groups[] @relation("custom_field_groups_updated_by")

  @@index([email], map: "idx_users_email")
  @@index([status], map: "idx_users_status")
}

model user_access_scopes {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @unique @db.Uuid
  scope      String    @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([scope], map: "idx_user_access_scopes_scope")
}

model utm_trackings {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id            String?    @db.Uuid
  campaign_id        String?    @db.Uuid
  utm_source         String?    @db.VarChar(255)
  utm_medium         String?    @db.VarChar(255)
  utm_campaign       String?    @db.VarChar(255)
  utm_content        String?    @db.VarChar(255)
  utm_term           String?    @db.VarChar(255)
  gclid              String?
  fbclid             String?
  landing_page       String?
  referrer           String?
  leadgen_form_id    String?    @db.VarChar(255)
  leadgen_adgroup_id String?    @db.VarChar(255)
  facebook_sender_id String?    @db.VarChar(255)
  inbox_url          String?
  website_url        String?
  bizfly_bot_id      String?    @db.VarChar(255)
  created_at         DateTime?  @default(now()) @db.Timestamp(6)
  campaigns          campaigns? @relation(fields: [campaign_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leads              leads?     @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([utm_source], map: "idx_utm_source")
  @@index([created_at, id], map: "idx_utm_trackings_created_page")
  @@index([campaign_id], map: "idx_utm_trackings_campaign_id")
  @@index([campaign_id, created_at, id], map: "idx_utm_trackings_campaign_created_page")
  @@index([lead_id], map: "idx_utm_trackings_lead_id")
  @@index([utm_medium, created_at, id], map: "idx_utm_trackings_medium_created_page")
  @@index([utm_source, created_at, id], map: "idx_utm_trackings_source_created_page")
}

model automation_rules {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_program_id String?               @db.Uuid
  name                   String                @db.VarChar(255)
  description            String?
  is_active              Boolean               @default(false)
  trigger_type           String                @db.VarChar(100)
  graph_data             Json
  version                Int                   @default(1)
  created_by             String?               @db.Uuid
  created_at             DateTime?             @default(now()) @db.Timestamp(6)
  updated_at             DateTime?             @default(now()) @db.Timestamp(6)
  users                  users?                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institution_programs   institution_programs? @relation(fields: [institution_program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  automation_execution_logs automation_execution_logs[]

  @@index([is_active, trigger_type], map: "idx_automation_rules_active_trigger")
  @@index([institution_program_id, created_at, id], map: "idx_automation_rules_program_created_page")
  @@index([created_at, id], map: "idx_automation_rules_created_page")
}

model automation_execution_logs {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule_id       String            @db.Uuid
  status        String            @default("running") @db.VarChar(50)
  context_data  Json?
  error_message String?
  started_at    DateTime?         @default(now()) @db.Timestamp(6)
  completed_at  DateTime?         @db.Timestamp(6)
  automation_rules automation_rules @relation(fields: [rule_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([rule_id, started_at, id], map: "idx_automation_exec_logs_rule_started_page")
  @@index([status, started_at, id], map: "idx_automation_exec_logs_status_started_page")
}
