# Copy to apps/metabase/.env. Never commit the real values.
POSTGRES_DB=metabase_app
POSTGRES_USER=metabase_app
POSTGRES_PASSWORD=replace-with-a-long-random-metadata-database-password

MB_DB_TYPE=postgres
# MB_DB_DBNAME, MB_DB_USER và MB_DB_PASS được Compose ánh xạ từ POSTGRES_* để tránh lệch credential.
MB_EMBEDDING_SECRET_KEY=replace-with-the-same-secret-as-api-metabase-embedding-secret
JAVA_TIMEZONE=Asia/Bangkok
