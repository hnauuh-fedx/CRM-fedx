{
  "name": "admission-crm",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare:cloud:web": "node scripts/build-cloud-web.mjs",
    "dev": "concurrently -n web,api,webhook-worker,automation-worker,integrations,reminders -c blue,green,magenta,yellow,cyan,white \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:webhook-worker\" \"npm run dev:automation-worker\" \"npm run dev:integrations\" \"npm run dev:reminders\"",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:monitor": "npm run monitor:operations --workspace apps/api",
    "dev:integrations": "npm run worker:integrations --workspace apps/api",
    "dev:reminders": "npm run worker:reminders --workspace apps/api",
    "dev:webhook-worker": "npm run worker:webhooks --workspace apps/api",
    "dev:automation-worker": "npm run worker:automation --workspace apps/api"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tar": "7.5.22"
  }
}
