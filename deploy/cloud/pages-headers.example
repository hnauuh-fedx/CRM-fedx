# Optional _headers template: copy to apps/web/public/_headers only when activating Pages hosting.
# Do not copy this file as a public downloadable config file.
/index.html
  Cache-Control: no-store
/version.json
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
