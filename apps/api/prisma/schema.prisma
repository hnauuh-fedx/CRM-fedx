generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model addresses {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id        String?     @db.Uuid
  type           String      @db.VarChar(100)
  province       String?     @db.VarChar(150)
  district       String?     @db.VarChar(150)
  ward           String?     @db.VarChar(150)
  hamlet         String?     @db.VarChar(150)
  detail_address String?
  created_at     DateTime?   @default(now()) @db.Timestamp(6)
  leads          leads?      @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  relatives      relatives[]
}

model admission_documents {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id       String?   @db.Uuid
  document_type String    @db.VarChar(150)
  file_id       String?   @db.Uuid
  status        String?   @default("pending") @db.VarChar(50)
  uploaded_at   DateTime? @default(now()) @db.Timestamp(6)
  files         files?    @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leads         leads?    @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model admission_profiles {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id                   String?               @unique @db.Uuid
  institution_program_id    String?               @db.Uuid
  major_id                  String?               @db.Uuid
  training_type             String?               @db.VarChar(150)
  admission_code            String?               @db.VarChar(100)
  class_code                String?               @db.VarChar(100)
  subject_group_code        String?               @db.VarChar(100)
  subject_group_name        String?               @db.VarChar(255)
  score_1                   Decimal?              @db.Decimal(5, 2)
  score_2                   Decimal?              @db.Decimal(5, 2)
  score_3                   Decimal?              @db.Decimal(5, 2)
  admission_score           Decimal?              @db.Decimal(5, 2)
  admission_status_id       String?               @db.Uuid
  fee_status                String?               @db.VarChar(100)
  tuition_status            String?               @db.VarChar(100)
  student_card_status       String?               @db.VarChar(100)
  application_received_date DateTime?             @db.Date
  telesale_received_date    DateTime?             @db.Date
  enrollment_batch          String?               @db.VarChar(150)
  training_code             String?               @db.VarChar(100)
  registration_station      String?               @db.VarChar(150)
  decision_number           String?               @db.VarChar(150)
  decision_signed_date      DateTime?             @db.Date
  monthly_revenue           Decimal?              @default(0) @db.Decimal(15, 2)
  created_at                DateTime?             @default(now()) @db.Timestamp(6)
  updated_at                DateTime?             @default(now()) @db.Timestamp(6)
  admission_statuses        admission_statuses?   @relation(fields: [admission_status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institution_programs      institution_programs? @relation(fields: [institution_program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leads                     leads?                @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  majors                    majors?               @relation(fields: [major_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students                  students?

  @@index([lead_id], map: "idx_admission_profiles_lead_id")
  @@index([institution_program_id, created_at, id], map: "idx_admission_profiles_program_created_page")
  @@index([major_id], map: "idx_admission_profiles_major_id")
  @@index([admission_status_id], map: "idx_admission_profiles_status_id")
  @@index([created_at, id], map: "idx_admission_profiles_created_page")
  @@index([application_received_date, id], map: "idx_admission_profiles_received_page")
}

model admission_statuses {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String               @db.VarChar(150)
  code               String               @unique @db.VarChar(100)
  color              String?              @db.VarChar(50)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  admission_profiles admission_profiles[]
}

model audit_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  entity_type String    @db.VarChar(100)
  entity_id   String?   @db.Uuid
  action      String    @db.VarChar(100)
  old_data    Json?
  new_data    Json?
  ip_address  String?   @db.VarChar(100)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([action, created_at, id], map: "idx_audit_logs_action_created_page")
  @@index([entity_type, created_at, id], map: "idx_audit_logs_type_created_page")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([user_id], map: "idx_audit_logs_user_id")
  @@index([user_id, created_at, id], map: "idx_audit_logs_user_created_page")
}

model automation_jobs {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         String    @db.VarChar(100)
  payload      Json?
  status       String?   @default("pending") @db.VarChar(50)
  run_at       DateTime? @db.Timestamp(6)
  completed_at DateTime? @db.Timestamp(6)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
}

model campaigns {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_program_id String?               @db.Uuid
  name                   String                @db.VarChar(255)
  type                   String?               @db.VarChar(100)
  start_date             DateTime?             @db.Date
  end_date               DateTime?             @db.Date
  budget                 Decimal?              @default(0) @db.Decimal(15, 2)
  status                 String?               @default("active") @db.VarChar(50)
  created_by             String?               @db.Uuid
  created_at             DateTime?             @default(now()) @db.Timestamp(6)
  users                  users?                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institution_programs   institution_programs? @relation(fields: [institution_program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  marketing_forms        marketing_forms[]
  utm_trackings          utm_trackings[]

  @@index([created_at, id], map: "idx_campaigns_created_page")
  @@index([institution_program_id, created_at, id], map: "idx_campaigns_program_created_page")
  @@index([status, created_at, id], map: "idx_campaigns_status_created_page")
  @@index([type, created_at, id], map: "idx_campaigns_type_created_page")
}

model custom_field_values {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  custom_field_id String?        @db.Uuid
  entity_type     String         @db.VarChar(100)
  entity_id       String         @db.Uuid
  value           String?
  value_text      String?
  value_number    Decimal?       @db.Decimal(20, 6)
  value_date      DateTime?      @db.Timestamp(6)
  value_boolean   Boolean?
  value_json      Json?
  created_at      DateTime?      @default(now()) @db.Timestamp(6)
  updated_at      DateTime?      @default(now()) @db.Timestamp(6)
  custom_fields   custom_fields? @relation(fields: [custom_field_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "idx_custom_field_values_entity")
  @@index([custom_field_id, value_text], map: "idx_custom_field_values_text_lookup")
  @@index([custom_field_id, value_number], map: "idx_custom_field_values_number_lookup")
  @@index([custom_field_id, value_date], map: "idx_custom_field_values_date_lookup")
  @@index([custom_field_id, value_boolean], map: "idx_custom_field_values_boolean_lookup")
  @@unique([custom_field_id, entity_type, entity_id], map: "uq_custom_field_values_field_entity")
}

model custom_field_groups {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type   String          @db.VarChar(50)
  group_key     String          @db.VarChar(150)
  group_label   String          @db.VarChar(255)
  description   String?
  is_system     Boolean         @default(false)
  is_active     Boolean         @default(true)
  display_order Int             @default(0)
  archived_at   DateTime?       @db.Timestamp(6)
  created_by_id String?         @db.Uuid
  updated_by_id String?         @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  updated_at    DateTime        @default(now()) @db.Timestamp(6)
  custom_fields custom_fields[]
  created_by    users?          @relation("custom_field_groups_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by    users?          @relation("custom_field_groups_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([entity_type, group_key], map: "uq_custom_field_groups_entity_key")
  @@index([entity_type, archived_at, display_order, id], map: "idx_custom_field_groups_entity_order")
}

model custom_fields {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module              String                @db.VarChar(100)
  field_key           String                @db.VarChar(150)
  field_label         String                @db.VarChar(255)
  field_type          String                @db.VarChar(100)
  is_required         Boolean?              @default(false)
  description         String?
  entity_type         String?               @db.VarChar(50)
  scope_type          String?               @default("GLOBAL") @db.VarChar(20)
  program_id          String?               @db.Uuid
  is_active           Boolean?              @default(true)
  archived_at         DateTime?             @db.Timestamp(6)
  is_searchable       Boolean?              @default(false)
  is_filterable       Boolean?              @default(false)
  is_sensitive        Boolean?              @default(false)
  display_order       Int?                  @default(0)
  options             Json?
  validation_rules    Json?
  default_value       Json?
  created_by_id       String?               @db.Uuid
  updated_by_id       String?               @db.Uuid
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  group_id            String                @db.Uuid
  custom_field_values custom_field_values[]
  custom_field_groups custom_field_groups   @relation(fields: [group_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  institution_programs institution_programs? @relation(fields: [program_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by          users?                @relation("custom_fields_created_by", fields: [created_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by          users?                @relation("custom_fields_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([entity_type, scope_type, program_id, display_order, id], map: "idx_custom_fields_entity_scope_order")
  @@index([group_id, display_order, id], map: "idx_custom_fields_group_order")
}

model departments {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @db.VarChar(150)
  code             String?            @unique @db.VarChar(100)
  manager_id       String?            @db.Uuid
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  users            users?             @relation(fields: [manager_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lead_assignments lead_assignments[]
  user_departments user_departments[]
}

model entity_tags {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tag_id      String?   @db.Uuid
  entity_type String    @db.VarChar(100)
  entity_id   String    @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  tags        tags?     @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "idx_entity_tags_entity")
}

model faculties {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @db.VarChar(255)
  code            String?           @unique @db.VarChar(100)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  majors          majors[]
  student_classes student_classes[]
  students        students[]
}

model file_relations {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file_id     String?   @db.Uuid
  entity_type String    @db.VarChar(100)
  entity_id   String    @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  files       files?    @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "idx_file_relations_entity")
}

model institutions {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                 @db.VarChar(255)
  code                 String                 @unique @db.VarChar(100)
  status               String?                @default("active") @db.VarChar(50)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  institution_programs institution_programs[]
}

model program_types {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                 @db.VarChar(150)
  code                 String                 @unique @db.VarChar(100)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  institution_programs institution_programs[]
}

model institution_programs {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id     String               @db.Uuid
  program_type_id    String               @db.Uuid
  name               String               @db.VarChar(255)
  code               String               @unique @db.VarChar(100)
  status             String?              @default("active") @db.VarChar(50)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  institutions       institutions         @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  program_types      program_types        @relation(fields: [program_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  admission_profiles admission_profiles[]
  automation_rules   automation_rules[]
  campaigns          campaigns[]
  custom_fields      custom_fields[]
  kpi_targets        kpi_targets[]
  lead_sources       lead_sources[]
  leads              leads[]
  report_configs     report_configs[]
  role_institution_programs role_institution_programs[]
  students           students[]
  majors             majors[]

  @@unique([institution_id, program_type_id, name])
  @@index([institution_id, status, name], map: "idx_institution_programs_institution_status")
  @@index([program_type_id, status, name], map: "idx_institution_programs_type_status")
}

model files {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file_name           String                @db.VarChar(255)
  file_url            String
  mime_type           String?               @db.VarChar(100)
  file_size           BigInt?
  uploaded_by         String?               @db.Uuid
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  admission_documents admission_documents[]
  file_relations      file_relations[]
  users               users?                @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model lead_activities {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id    String?   @db.Uuid
  user_id    String?   @db.Uuid
  type       String    @db.VarChar(100)
  content    String?
  metadata   Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  leads      leads?    @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_lead_activities_created_at")
  @@index([lead_id], map: "idx_lead_activities_lead_id")
  @@index([type, created_at, id], map: "idx_lead_activities_type_created_page")
  @@index([user_id], map: "idx_lead_activities_user_id")
  @@index([user_id, created_at, id], map: "idx_lead_activities_user_created_page")
}

model lead_assignments {
  id                                        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id                                   String?      @db.Uuid
  assigned_to                               String?      @db.Uuid
  assigned_by                               String?      @db.Uuid
  department_id                             String?      @db.Uuid
  is_main_owner                             Boolean?     @default(true)
  assigned_at                               DateTime?    @default(now()) @db.Timestamp(6)
  users_lead_assignments_assigned_byTousers users?       @relation("lead_assignments_assigned_byTousers", fields: [assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_lead_assignments_assigned_toTousers users?       @relation("lead_assignments_assigned_toTousers", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments                               departments? @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leads                                     leads?       @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assigned_to], map: "idx_lead_assignments_assigned_to")
  @@index([assigned_at, id], map: "idx_lead_assignments_assigned_page")
  @@index([assigned_to, is_main_owner, lead_id], map: "idx_lead_assignments_assignee_scope")
  @@index([assigned_to, assigned_at, id], map: "idx_lead_assignments_assignee_page")
  @@index([department_id, is_main_owner, lead_id], map: "idx_lead_assignments_department_scope")
  @@index([department_id, assigned_at, id], map: "idx_lead_assignments_department_page")
  @@index([lead_id], map: "idx_lead_assignments_lead_id")
}

model lead_notes {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id    String?   @db.Uuid
  user_id    String?   @db.Uuid
  content    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  leads      leads?    @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model lead_sources {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_program_id String?               @db.Uuid
  name                   String                @db.VarChar(150)
  type                   String?               @db.VarChar(100)
  created_at             DateTime?             @default(now()) @db.Timestamp(6)
  institution_programs   institution_programs? @relation(fields: [institution_program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leads                  leads[]
  marketing_forms        marketing_forms[]

  @@index([created_at, id], map: "idx_lead_sources_created_page")
  @@index([institution_program_id, created_at, id], map: "idx_lead_sources_program_created_page")
  @@index([type, created_at, id], map: "idx_lead_sources_type_created_page")
}

model lead_status_histories {
  id                                                                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id                                                              String?          @db.Uuid
  from_stage_id                                                        String?          @db.Uuid
  to_stage_id                                                          String?          @db.Uuid
  changed_by                                                           String?          @db.Uuid
  changed_at                                                           DateTime?        @default(now()) @db.Timestamp(6)
  users                                                                users?           @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pipeline_stages_lead_status_histories_from_stage_idTopipeline_stages pipeline_stages? @relation("lead_status_histories_from_stage_idTopipeline_stages", fields: [from_stage_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leads                                                                leads?           @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pipeline_stages_lead_status_histories_to_stage_idTopipeline_stages   pipeline_stages? @relation("lead_status_histories_to_stage_idTopipeline_stages", fields: [to_stage_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model leads {
  id                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_code                      String?                 @unique @db.VarChar(100)
  full_name                      String                  @db.VarChar(255)
  gender                         String?                 @db.VarChar(20)
  date_of_birth                  DateTime?               @db.Date
  phone                          String                  @db.VarChar(30)
  email                          String?                 @db.VarChar(255)
  cccd                           String?                 @db.VarChar(30)
  source_id                      String?                 @db.Uuid
  institution_program_id         String?                 @db.Uuid
  major_id                       String?                 @db.Uuid
  pipeline_stage_id              String?                 @db.Uuid
  owner_id                       String?                 @db.Uuid
  assigned_to                    String?                 @db.Uuid
  status                         String?                 @default("new") @db.VarChar(50)
  lead_score                     Int?                    @default(0)
  temperature                    String?                 @db.VarChar(50)
  note                           String?
  created_at                     DateTime?               @default(now()) @db.Timestamp(6)
  updated_at                     DateTime?               @default(now()) @db.Timestamp(6)
  deleted_at                     DateTime?               @db.Timestamp(6)
  addresses                      addresses[]
  admission_documents            admission_documents[]
  admission_profiles             admission_profiles?
  lead_activities                lead_activities[]
  lead_assignments               lead_assignments[]
  lead_notes                     lead_notes[]
  lead_status_histories          lead_status_histories[]
  marketing_form_submissions     marketing_form_submissions[]
  users_leads_assigned_toTousers users?                  @relation("leads_assigned_toTousers", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_leads_owner_idTousers    users?                  @relation("leads_owner_idTousers", fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pipeline_stages                pipeline_stages?        @relation(fields: [pipeline_stage_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lead_sources                   lead_sources?           @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institution_programs           institution_programs?   @relation(fields: [institution_program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  majors                         majors?                 @relation(fields: [major_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  relatives                      relatives[]
  reminders                      reminders[]
  student_profiles               student_profiles?
  students                       students?
  utm_trackings                  utm_trackings[]

  @@index([assigned_to], map: "idx_leads_assigned_to")
  @@index([assigned_to, created_at, id], map: "idx_leads_assignee_created_page")
  @@index([cccd], map: "idx_leads_cccd")
  @@index([created_at], map: "idx_leads_created_at")
  @@index([deleted_at, created_at, id], map: "idx_leads_active_created_page")
  @@index([email], map: "idx_leads_email")
  @@index([owner_id], map: "idx_leads_owner_id")
  @@index([phone], map: "idx_leads_phone")
  @@index([pipeline_stage_id], map: "idx_leads_pipeline_stage")
  @@index([source_id], map: "idx_leads_source_id")
  @@index([source_id, created_at, id], map: "idx_leads_source_created_page")
  @@index([institution_program_id, created_at, id], map: "idx_leads_program_created_page")
  @@index([major_id, created_at, id], map: "idx_leads_major_created_page")
  @@index([status], map: "idx_leads_status")
